# DeepSeek API 配置
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# API 参数配置
API_TEMPERATURE=0.7
API_MAX_TOKENS=150

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mita_agent

# 日志配置
LOG_LEVEL=INFO
LOG_ENABLED=False
CONSOLE_OUTPUT=True
MAX_LOG_SIZE=5242880
BACKUP_COUNT=3
